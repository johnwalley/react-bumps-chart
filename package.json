{
  "name": "react-bumps-chart",
  "version": "1.13.0",
  "type": "module",
  "description": "React Bumps Chart is a library for drawing rowing bumps charts.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js"
    },
    "./dist/*.js": "./dist/*.js",
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "pdf": [
        "./dist/pdf.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc && NODE_ENV=production vite build",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run",
    "release": "standard-version",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnwalley/react-bumps-chart.git"
  },
  "author": "John Walley",
  "license": "MIT",
  "devDependencies": {
    "@react-pdf/renderer": "^4.3.0",
    "@storybook/addon-docs": "^10.1.10",
    "@storybook/addon-links": "^10.1.10",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.2",
    "@storybook/react-vite": "^10.1.10",
    "@types/d3-array": "^3.2.2",
    "@types/d3-delaunay": "^6.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/lodash": "^4.17.21",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "prettier": "^3.7.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "standard-version": "9.5.0",
    "storybook": "^10.1.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "d3-array": "^2.0.0",
    "d3-delaunay": "^6.0.4",
    "d3-scale": "^3.0.0",
    "d3-shape": "^2.0.0",
    "lodash": "^4.17.21",
    "react-rowing-blades": "^2.4.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@react-pdf/renderer": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "@react-pdf/renderer": {
      "optional": true
    }
  }
}
